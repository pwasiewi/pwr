[Unit]
Description=pwngrid peer service
Documentation=https://github.com/jayofelony/pwngrid
Wants=network.target
After=network.target bettercap.service

[Service]
Type=simple
EnvironmentFile=-/etc/conf.d/pwngrid-peer
ExecStart=/usr/bin/pwngrid $PWNGRID_OPTS
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
