[Unit]
Description=pwnagotchi - instruments bettercap for WiFi handshake capture
Documentation=https://github.com/jayofelony/pwnagotchi/wiki
Wants=network.target
After=network.target bettercap.service pwngrid-peer.service

[Service]
Type=simple
EnvironmentFile=-/etc/conf.d/pwnagotchi
ExecStart=/usr/bin/pwnagotchi $PWNAGOTCHI_OPTS
Restart=always
RestartSec=30
TasksMax=infinity

[Install]
WantedBy=multi-user.target
