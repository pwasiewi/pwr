+/*---------------------------------------------------------*\
+| Cleanup hooks live outside the class so that adding them  |
+| does not change the DetectionManager layout seen by       |
+| plugins.                                                  |
+\*---------------------------------------------------------*/
+static std::vector<CleanupHookFunction>  cleanup_hooks;
+static std::mutex                        cleanup_hooks_mutex;
+
+void DetectionManager::RegisterCleanupHook(CleanupHookFunction hook)
+{
+    std::lock_guard<std::mutex> lock(cleanup_hooks_mutex);
+
+    cleanup_hooks.push_back(hook);
+}
+
 void DetectionManager::Cleanup()
 {
     LOG_INFO("[%s] Cleaning up detected devices", DETECTIONMANAGER);
 
+    /*-----------------------------------------------------*\
+    | Run cleanup hooks first, while every static object is |
+    | still alive and before the controller list is         |
+    | cleared: a detector thread that registers a           |
+    | controller after ProcessCleanup() would leave it      |
+    | running into static destruction at exit.              |
+    \*-----------------------------------------------------*/
+    std::vector<CleanupHookFunction> hooks;
+
+    {
+        std::lock_guard<std::mutex> lock(cleanup_hooks_mutex);
+
+        hooks.swap(cleanup_hooks);
+    }
+
+    for(std::size_t hook_idx = 0; hook_idx < hooks.size(); hook_idx++)
+    {
+        hooks[hook_idx]();
+    }
+
     ProcessPreDetectionHooks();
     ProcessCleanup();
 }
