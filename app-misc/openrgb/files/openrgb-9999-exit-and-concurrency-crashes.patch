+/*---------------------------------------------------------*\
+| Read until the reply to our own request arrives. hidraw   |
+| hands every input report to every open handle, so when    |
+| another process (a second openrgb instance) talks to the  |
+| same controller at the same time, its replies land in our |
+| queue too and the first report read is not necessarily    |
+| ours. Give up after a few reports or a read timeout.      |
+\*---------------------------------------------------------*/
+static bool AuraUSBReadReply(hid_device* dev, unsigned char* buf, size_t len, unsigned char reply_id)
+{
+    for(int attempt = 0; attempt < 8; attempt++)
+    {
+        if(hid_read_timeout(dev, buf, len, 1000) <= 0)
+        {
+            return(false);
+        }
+
+        if(buf[1] == reply_id)
+        {
+            return(true);
+        }
+    }
+
+    return(false);
+}
