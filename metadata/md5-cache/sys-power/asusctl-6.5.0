DESCRIPTION=Daemon, CLI and optional GUI for controlling ASUS laptop features
EAPI=8
HOMEPAGE=https://asus-linux.org https://github.com/OpenGamingCollective/asusctl
IDEPEND=dev-util/desktop-file-utils x11-misc/shared-mime-info
INHERIT=cargo desktop linux-info systemd udev xdg
IUSE=acpi +gui X debug
KEYWORDS=~amd64
